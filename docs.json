{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "OpenController",
  "colors": {
    "primary": "#3d5a86",
    "light": "#9db2d4",
    "dark": "#3d5a86"
  },
  "fonts": {
    "heading": {
      "family": "Manrope",
      "weight": 600
    },
    "body": {
      "family": "Manrope",
      "weight": 400
    }
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#1a1917"
    }
  },
  "styling": {
    "codeblocks": "dark",
    "eyebrows": "section"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "height": 32
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "get-started/what-is-shadow-ai",
              "get-started/how-it-works",
              "get-started/modules",
              "get-started/quickstart",
              "get-started/rollout",
              "get-started/concepts",
              "get-started/glossary"
            ]
          },
          {
            "group": "Set up",
            "pages": [
              "setup/install",
              "setup/sign-in",
              "setup/members",
              "setup/service-accounts",
              "setup/secrets",
              "administration/roles"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "connect/overview",
              "connect/aws",
              "connect/microsoft",
              "connect/google-cloud",
              "connect/databricks",
              "connect/anthropic",
              "connect/snowflake",
              "connect/scans",
              "connect/claude-code"
            ]
          },
          {
            "group": "Discover",
            "pages": [
              "discover/overview",
              "discover/inventory",
              "discover/map",
              "discover/shadow-ai",
              "discover/people",
              "discover/spend"
            ]
          },
          {
            "group": "Govern",
            "pages": [
              "govern/registry",
              "govern/approvals",
              "govern/policies",
              "govern/audit-log"
            ]
          },
          {
            "group": "Control",
            "pages": [
              "govern/respond",
              "govern/control-actions"
            ]
          },
          {
            "group": "LLM gateway and guardrails",
            "pages": [
              "runtime/llm-gateway",
              "runtime/virtual-keys",
              "runtime/teams-and-customers",
              "runtime/gateway-logs",
              "runtime/guardrails",
              "runtime/guardrail-checks",
              "runtime/guardrail-violations",
              "runtime/guardrails-api"
            ]
          },
          {
            "group": "Posture",
            "pages": [
              "posture/findings",
              "posture/security-policies",
              "posture/frameworks"
            ]
          },
          {
            "group": "Observe",
            "pages": [
              "monitor/observability",
              "monitor/send-traces",
              "monitor/traces-and-issues",
              "monitor/cost"
            ]
          },
          {
            "group": "Evaluate",
            "pages": [
              "monitor/evals",
              "monitor/evaluators-and-tasks",
              "monitor/monitors-and-datasets"
            ]
          },
          {
            "group": "Ask Ctrl",
            "pages": [
              "assistant/ask-ctrl",
              "assistant/mcp"
            ]
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "mcp"
    ]
  },
  "icons": {
    "library": "lucide"
  },
  "api": {
    "playground": {
      "display": "simple"
    },
    "mdx": {
      "auth": {
        "method": "bearer"
      }
    }
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true,
    "raiseIssue": true
  },
  "seo": {
    "indexing": "navigable"
  },
  "errors": {
    "404": {
      "redirect": true
    }
  },
  "search": {
    "prompt": "Search the docs, or ask a question"
  },
  "footer": {
    "links": [
      {
        "header": "OpenController",
        "items": [
          {
            "label": "Documentation",
            "href": "https://github.com/NeuralgoLyzr/opencontroller-documentation"
          }
        ]
      }
    ]
  }
}
